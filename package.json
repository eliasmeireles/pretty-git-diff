{
  "name": "pretty-git-diff",
  "displayName": "Pretty Git Diff",
  "description": "Compare Git branches and commits with visual diff interface",
  "homepage": "https://github.com/eliasmeireles",
  "readme": "README.md",
  "version": "0.0.6",
  "publisher": "eliasmeireles",

  "categories": ["Other"],
  "keywords": ["Git", "Diff", "Compare", "Branch", "Commit"],
  "icon": "accets/icon.png",
  "activationEvents": [
    "onCommand:branchDiff.compareWithBranch",
    "onCommand:branchDiff.compareDirectory",
    "onCommand:branchDiff.applyBranchChanges"
  ],
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.91.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "branchDiff.compareWithBranch",
        "title": "Pretty Git Diff: File"
      },
      {
        "command": "branchDiff.compareDirectory",
        "title": "Pretty Git Diff: Directory"
      },
      {
        "command": "branchDiff.applyBranchChanges",
        "title": "Pretty Git Diff: Apply"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "branchDiff.compareDirectory"
        }
      ],
      "editor/context": [
        {
          "command": "branchDiff.compareWithBranch",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "branchDiff.applyBranchChanges",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "branchDiff.compareWithBranch",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "branchDiff.compareDirectory",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "branchDiff.applyBranchChanges",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliasmeireles/pretty-git-diff.git"
  },
  "devDependencies": {
    "typescript": "^4.0.3",
    "vscode": "^1.1.37",
    "@types/node": "^12.11.7",
    "vsce": "^2.10.0"
  }
}
